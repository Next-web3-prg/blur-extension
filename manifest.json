{
  "manifest_version": 3,
  "name": "Image Blur Toggle",
  "version": "2.4.3",
  "description": "Blur images, videos, and backgrounds on any webpage. Toggle instantly with Alt+L.",
  "icons": {
    "16": "icons/enabled-16.png",
    "32": "icons/enabled-32.png",
    "48": "icons/enabled-48.png",
    "128": "icons/enabled-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Blur Toggle",
    "default_icon": {
      "16": "icons/enabled-16.png",
      "32": "icons/enabled-32.png",
      "48": "icons/enabled-48.png",
      "128": "icons/enabled-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-blur": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Toggle image blur"
    }
  }
}
